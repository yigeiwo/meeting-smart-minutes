# ============================================================
#  飞书会议智能妙记 · 环境变量样例 (复制为 .env 后填写真实凭据)
#  说明: 留空的项不会伪造成功, 相关功能会如实失败并回传错误原因。
# ============================================================

# ---------- 飞书开放平台自建应用 ----------
FEISHU_APP_ID=cli_xxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
FEISHU_BOT_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxxxxxx
FEISHU_BOT_SECRET=
FEISHU_DOC_FOLDER_TOKEN=
FEISHU_BITABLE_APP_TOKEN=
FEISHU_BITABLE_TABLE_ID=

# ---------- 大模型 (DeepSeek / 豆包 / OpenAI / Claude / Kimi / 自建 Ollama 均可) ----------
LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.3

# ---------- 默认会议总结场景 (general, tech, prd, business, brainstorm) ----------
DEFAULT_SCENARIO=general

# ---------- 语音转写 ASR ----------
ASR_PROVIDER=whisper
ASR_API_KEY=

# ---------- 硬件胸卡桥接 ----------
BRIDGE_HOST=0.0.0.0
# 局域网直连用的裸 TCP 端口 (wss 走 443 时用不到, 保留以兼容本地调试)
BRIDGE_PORT=5566
# 胸卡 WebSocket 通道 (/ws/card) 的设备令牌。
# 公网部署务必设置: 否则任何人只要能连上该路径, 就能伪造胸卡报文并注入会议音频。
CARD_WS_TOKEN=

# ---------- 用户注册开关 ----------
# 默认 false (内部系统, 不开放自助注册); 需要开放时改为 true
ALLOW_REGISTER=false

# ---------- Web 服务 ----------
WEB_HOST=127.0.0.1
WEB_PORT=8000

# ---------- 数据与录音目录 ----------
RECORDS_DIR=records

# ---------- PostgreSQL 企业数据库 (默认启用) ----------
PG_ENABLED=true
PG_HOST=127.0.0.1
PG_PORT=5432
PG_DATABASE=feishu_meeting
PG_USER=postgres
PG_PASSWORD=
