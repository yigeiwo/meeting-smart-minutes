# ================= 飞书开放平台配置 =================
FEISHU_APP_ID=cli_axxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
FEISHU_BOT_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxx
FEISHU_BOT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
FEISHU_DOC_FOLDER_TOKEN=fldcnxxxxxxxxxxxxxxxxxxxx

# ================= 多 AI 大模型配置 (NewAPI / DeepSeek / 豆包 / OpenAI) =================
ACTIVE_LLM_ID=deepseek
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.3
DEFAULT_SCENARIO=general

# ================= PostgreSQL 企业数据库配置 (默认启用) =================
PG_ENABLED=true
PG_HOST=127.0.0.1
PG_PORT=5432
PG_DATABASE=feishu_meeting
PG_USER=postgres
PG_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/feishu_meeting

# ================= 网络与服务端口配置 =================
WEB_HOST=0.0.0.0
WEB_PORT=8000
BRIDGE_HOST=0.0.0.0
BRIDGE_PORT=5566
